  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A level is a map where the player will go through multiple waves of enemies.
    Once the player beats all levels, they win the game.\r\n\nThe collection of cards
    that the player keeps permanently throughout all levels. Cards can be permanently
    added or removed from the deck throughout the game.\r\n\nThe cards that are available
    for the player to play\r\n\nThe pile that the player draws cards from into their
    hand. At the start of a level, all cards from your deck are placed in it.\r\n\nTake
    a card from the draw pile into your hand\r\n\nThe pile that cards go to once
    played from the player\u2019s hand. Once the draw pile runs out of cards, the
    discard pile is shuffled into the draw pile.\r\n\nMove a card into the discard
    pile after you\u2019ve played it\r\n\nThe full set of cards that can be added
    to your deck (basically a collection of every card in the game that the player
    can obtain)\r\n\nPermanently removing a card from the deck\r\n\nPermanently adding
    a card to the deck (different from drawing a card)\r\n\nRemoving a card from
    your deck for the remainder of the level instead of adding it to the discard
    pile."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
